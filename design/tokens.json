{
  "name": "Antrum Dark Graphite Liquid Glass",
  "version": "alpha",
  "principles": [
    "local-trust-first",
    "native-before-custom",
    "one-job-per-state",
    "glass-is-structure",
    "spectral-color-means-live-audio"
  ],
  "color": {
    "canvas": {
      "paper": "#1C2023",
      "nearBlack": "#24292D"
    },
    "surface": {
      "raised": "#2C3135",
      "hover": "#353B40",
      "active": "#41484E"
    },
    "border": {
      "default": "#4D555C",
      "subtle": "#41484E",
      "strong": "#596269"
    },
    "text": {
      "nearWhite": "#E4E9EF",
      "primary": "#D1D5D9",
      "muted": "#A8ABAF",
      "subtle": "#8A8C90"
    },
    "accent": {
      "focus": "#005C9B",
      "selection": "#00508E"
    },
    "waveform": [
      "#FF3D57",
      "#FF8F29",
      "#F5D12E",
      "#3DCC73",
      "#1FB8E6",
      "#5C80FF",
      "#C25CFF"
    ]
  },
  "typography": {
    "family": "SF Mono, Menlo, Monaco, monospace",
    "display": { "size": 31, "weight": "bold" },
    "title": { "size": 26, "weight": "bold" },
    "appTitle": { "size": 20, "weight": "bold" },
    "section": { "size": 18, "weight": "bold" },
    "body": { "size": 13, "weight": "regular" },
    "bodyStrong": { "size": 13, "weight": "semibold" },
    "caption": { "size": 12, "weight": "regular" },
    "captionStrong": { "size": 12, "weight": "semibold" },
    "micro": { "size": 11, "weight": "regular" },
    "microStrong": { "size": 11, "weight": "semibold" },
    "label": { "size": 10, "weight": "semibold" }
  },
  "spacing": {
    "xxs": 4,
    "xs": 6,
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 14,
    "xxl": 16,
    "xxxl": 18,
    "page": 24
  },
  "radius": {
    "badge": 6,
    "control": 7,
    "card": 10,
    "panel": 12,
    "dropTarget": 14,
    "hudBar": 2
  },
  "stroke": {
    "hairline": 1,
    "control": 1.5,
    "heavy": 2
  },
  "motion": {
    "quickFeedbackSeconds": 0.08,
    "maximumRoutineMotionSeconds": 0.2
  },
  "layer": {
    "base": 0,
    "content": 10,
    "modal": 20,
    "hud": 30,
    "toast": 40
  },
  "component": {
    "minimumTarget": 44,
    "dictationHUD": {
      "width": 172,
      "height": 54
    },
    "meetingDetectionHUD": {
      "width": 316,
      "height": 54
    },
    "dictationSettings": {
      "width": 760,
      "height": 500
    }
  }
}
